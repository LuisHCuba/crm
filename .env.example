# Banco de dados
POSTGRES_USER=lhcx
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE
POSTGRES_DB=lhcx

# API
JWT_SECRET=TROCAR_POR_SEGREDO_FORTE

# URL pública do front (usada nos links de redefinição de senha)
APP_URL=https://crm.lhcx.tech

# Admin inicial (usado apenas no primeiro deploy, quando nao existe nenhum usuario)
ADMIN_EMAIL=admin@lhcx.tech
ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE

# Backup automatico do PostgreSQL (formato cron ou @daily/@weekly)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Integracao n8n (deixe em branco para desativar os webhooks)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# SMTP para recuperacao de senha (deixe SMTP_HOST em branco para desativar o envio)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@lhcx.tech
