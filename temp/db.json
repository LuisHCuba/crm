          "jsonBody": "={{ JSON.stringify({ type: 'note', title: 'Lead recebido via ' + ($('Preparar Dados').item.json.source || 'website'), body: (function() { var d = $('Preparar Dados').item.json; var lines = []; lines.push('Nome: ' + d.fullName); lines.push('Email: ' + d.email); if (d.phone) lines.push('Telefone: ' + d.phone); if (d.jobTitle) lines.push('Interesse: ' + d.jobTitle); if (d.message) lines.push('Mensagem: ' + d.message); lines.push('Origem: ' + (d.source || 'website')); try { var fd = JSON.parse(d.formData || '{}'); var skip = ['name','nome','fullName','email','phone','telefone','message','mensagem','necessidades','interest','interesse','formType','utm_source','utm_medium','utm_campaign','utm_term','utm_content']; lines.push(''); lines.push('--- Dados do Formulário ---'); Object.keys(fd).forEach(function(k) { if (skip.indexOf(k) >= 0) return; var v = fd[k]; if (Array.isArray(v)) v = v.join(', '); if (v && String(v).trim()) lines.push(k + ': ' + v); }); } catch(e) {} if (d.utmSource || d.utmMedium || d.utmCampaign) { lines.push(''); lines.push('--- UTM ---'); if (d.utmSource) lines.push('Source: ' + d.utmSource); if (d.utmMedium) lines.push('Medium: ' + d.utmMedium); if (d.utmCampaign) lines.push('Campaign: ' + d.utmCampaign); if (d.utmTerm) lines.push('Term: ' + d.utmTerm); if (d.utmContent) lines.push('Content: ' + d.utmContent); } return lines.join('\\n'); })(), linkedContactId: $json.id }) }}",
